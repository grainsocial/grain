# Required for production
RELAY=wss://bsky.network
DID_PLC_URL=https://plc.directory
PORT=3000
DATABASE=data/hatk.db
# Public origin of this instance. Becomes the OAuth issuer and the base of every
# client_id and redirect_uri, so it must be the real origin — atproto OAuth
# rejects reserved and test TLDs.
APP_DOMAIN=your-app.example.com

OAUTH_ISSUER=https://your-app.example.com

# Admin access (comma-separated DIDs)
# ADMINS=did:plc:xxx

# Optional
# BACKFILL_REPOS=did:plc:xxx,did:plc:yyy
# BACKFILL_FULL_NETWORK=false
# BACKFILL_PARALLELISM=5
# FTS_REBUILD_INTERVAL=500
