{
  "lexicon": 1,
  "id": "social.grain.admin.listReports",
  "defs": {
    "main": {
      "type": "query",
      "description": "List reports, newest first. Requires an admin session.",
      "parameters": {
        "type": "params",
        "properties": {
          "status": {
            "type": "string",
            "knownValues": ["open", "resolved", "dismissed"],
            "default": "open"
          },
          "label": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["reports", "total"],
          "properties": {
            "reports": {
              "type": "array",
              "items": { "type": "ref", "ref": "social.grain.admin.defs#reportView" }
            },
            "cursor": { "type": "string" },
            "total": { "type": "integer", "description": "Reports matching, across every page." }
          }
        }
      }
    }
  }
}
