{
  "lexicon": 1,
  "id": "social.grain.story.getAuthors",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get authors who have active stories (posted within the last 24 hours).",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["authors"],
          "properties": {
            "authors": {
              "type": "array",
              "items": { "type": "ref", "ref": "social.grain.story.defs#storyAuthor" }
            }
          }
        }
      }
    }
  }
}
