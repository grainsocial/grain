{
  "lexicon": 1,
  "id": "social.grain.graph.getFollowers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get followers for a given user.",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": { "type": "string", "format": "at-identifier" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "totalCount": { "type": "integer" },
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "social.grain.graph.defs#followerItem" }
            },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
