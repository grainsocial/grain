{
  "lexicon": 1,
  "id": "social.grain.graph.getKnownFollowers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get followers of a given actor that the viewer, named by their service token, also follows.",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": { "type": "string", "format": "at-identifier" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 50 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "social.grain.graph.defs#knownFollowerItem" }
            }
          }
        }
      }
    }
  }
}
