{
  "lexicon": 1,
  "id": "social.grain.actor.getSuggestedFollows",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get suggested profiles to follow based on bsky follow graph.",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": { "type": "string", "format": "did" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "social.grain.actor.defs#suggestedFollow" }
            }
          }
        }
      }
    }
  }
}
