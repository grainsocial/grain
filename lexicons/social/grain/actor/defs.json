{
  "lexicon": 1,
  "id": "social.grain.actor.defs",
  "defs": {
    "profileView": {
      "type": "object",
      "required": ["did", "handle"],
      "properties": {
        "cid": { "type": "string", "format": "cid" },
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" },
        "displayName": {
          "type": "string",
          "maxGraphemes": 64,
          "maxLength": 640
        },
        "description": {
          "type": "string",
          "maxLength": 2560,
          "maxGraphemes": 256
        },
        "labels": {
          "type": "array",
          "items": {
            "ref": "com.atproto.label.defs#label",
            "type": "ref"
          }
        },
        "avatar": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "datetime" }
      }
    },
    "profileViewDetailed": {
      "type": "object",
      "required": ["did", "handle"],
      "properties": {
        "cid": { "type": "string", "format": "cid" },
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" },
        "displayName": {
          "type": "string",
          "maxGraphemes": 64,
          "maxLength": 640
        },
        "description": {
          "type": "string",
          "maxGraphemes": 256,
          "maxLength": 2560
        },
        "avatar": { "type": "string", "format": "uri" },
        "cameras": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of camera make and models used by this actor derived from EXIF data of photos linked to galleries."
        },
        "followersCount": { "type": "integer" },
        "followsCount": { "type": "integer" },
        "galleryCount": { "type": "integer" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "createdAt": { "type": "string", "format": "datetime" },
        "messageMe": { "type": "ref", "ref": "#messageMe" },
        "viewer": { "type": "ref", "ref": "#viewerState" },
        "labels": {
          "type": "array",
          "items": { "type": "ref", "ref": "com.atproto.label.defs#label" }
        }
      }
    },
    "messageMe": {
      "type": "object",
      "required": ["showButtonTo", "messageMeUrl"],
      "properties": {
        "messageMeUrl": { "type": "string", "format": "uri" },
        "showButtonTo": { "type": "string", "knownValues": ["usersIFollow", "everyone"] }
      }
    },
    "viewerState": {
      "type": "object",
      "description": "Metadata about the requesting account's relationship with the subject account. Only has meaningful content for authed requests.",
      "properties": {
        "following": { "type": "string", "format": "at-uri" },
        "followedBy": { "type": "string", "format": "at-uri" },
        "blocking": { "type": "string", "format": "at-uri" },
        "blockedBy": { "type": "boolean" },
        "muted": { "type": "boolean" }
      }
    },
    "profileSearchResult": {
      "type": "object",
      "required": ["did"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "avatar": { "type": "string" }
      }
    },
    "typeaheadItem": {
      "type": "object",
      "required": ["did"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string" },
        "displayName": { "type": "string" },
        "avatar": { "type": "string" }
      }
    },
    "suggestedFollow": {
      "type": "object",
      "required": ["did"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "avatar": { "type": "string" },
        "followersCount": { "type": "integer" }
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "union",
        "refs": ["#pinnedFeedsPref", "#photoMetadataPref", "#themePref", "#notificationsPref"]
      }
    },
    "pinnedFeedsPref": {
      "type": "object",
      "description": "The feeds pinned to the viewer's navigation.",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "type": "ref", "ref": "#pinnedFeed" },
          "description": "In the order they show."
        }
      }
    },
    "pinnedFeed": {
      "type": "object",
      "required": ["id", "label", "type", "path"],
      "properties": {
        "id": { "type": "string", "maxLength": 2048 },
        "label": { "type": "string", "maxLength": 640 },
        "type": { "type": "string", "knownValues": ["feed", "camera", "location", "hashtag"] },
        "path": {
          "type": "string",
          "maxLength": 2048,
          "description": "The page it opens, on this site."
        }
      }
    },
    "photoMetadataPref": {
      "type": "object",
      "description": "What an upload keeps of a photo's metadata.",
      "properties": {
        "includeExif": {
          "type": "boolean",
          "description": "Keep camera settings on uploaded photos."
        },
        "includeLocation": {
          "type": "boolean",
          "description": "Keep where a photo was taken on uploaded photos."
        }
      }
    },
    "themePref": {
      "type": "object",
      "required": ["theme"],
      "properties": {
        "theme": { "type": "string", "knownValues": ["system", "light", "dark"] }
      }
    },
    "notificationsPref": {
      "type": "object",
      "description": "How each kind of notification reaches the viewer. A kind left out takes the default: push and in-app, from anyone.",
      "properties": {
        "favorites": { "type": "ref", "ref": "#notificationPref" },
        "follows": { "type": "ref", "ref": "#notificationPref" },
        "comments": { "type": "ref", "ref": "#notificationPref" },
        "mentions": { "type": "ref", "ref": "#notificationPref" }
      }
    },
    "notificationPref": {
      "type": "object",
      "required": ["push", "inApp", "from"],
      "properties": {
        "push": { "type": "boolean" },
        "inApp": { "type": "boolean" },
        "from": { "type": "string", "knownValues": ["all", "follows"] }
      }
    }
  }
}
