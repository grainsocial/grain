{
  "lexicon": 1,
  "id": "social.grain.notification.defs",
  "defs": {
    "notificationItem": {
      "type": "object",
      "required": ["uri", "reason", "createdAt", "indexedAt", "isRead", "author"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "reason": {
          "type": "string",
          "knownValues": [
            "gallery-favorite",
            "gallery-comment",
            "gallery-comment-mention",
            "gallery-mention",
            "comment-favorite",
            "story-favorite",
            "story-comment",
            "reply",
            "follow"
          ]
        },
        "createdAt": { "type": "string", "format": "datetime" },
        "indexedAt": {
          "type": "string",
          "format": "datetime",
          "description": "When the index first held the record, or when it says it was made if that is earlier: what notifications are ordered by, and isRead and getUnreadCount compare with seenAt."
        },
        "isRead": {
          "type": "boolean",
          "description": "Whether the viewer had marked their notifications seen as of indexedAt."
        },
        "author": { "type": "ref", "ref": "social.grain.actor.defs#profileView" },
        "galleryUri": { "type": "string", "format": "at-uri" },
        "galleryTitle": { "type": "string" },
        "galleryThumb": { "type": "string" },
        "storyUri": { "type": "string", "format": "at-uri" },
        "storyThumb": { "type": "string" },
        "commentText": { "type": "string" },
        "replyToText": { "type": "string" }
      }
    }
  }
}
