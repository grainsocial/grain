{
  "lexicon": 1,
  "id": "social.grain.notification.listNotifications",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the authenticated user's notifications, the latest first, as app.bsky.notification.listNotifications does. Requires auth.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["notifications"],
          "properties": {
            "notifications": {
              "type": "array",
              "items": { "type": "ref", "ref": "social.grain.notification.defs#notificationItem" }
            },
            "cursor": { "type": "string" },
            "seenAt": {
              "type": "string",
              "format": "datetime",
              "description": "When the viewer last marked their notifications seen (updateSeen), if they have."
            }
          }
        }
      }
    }
  }
}
