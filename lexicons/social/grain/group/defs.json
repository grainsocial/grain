{
  "lexicon": 1,
  "id": "social.grain.group.defs",
  "defs": {
    "groupView": {
      "type": "object",
      "required": ["did", "handle"],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "handle": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "The group's own site, from its opensocial profile. Where the group is actually run."
        },
        "avatar": {
          "type": "string",
          "format": "uri"
        },
        "poolCount": {
          "type": "integer",
          "description": "Galleries in the pool."
        },
        "pendingCount": {
          "type": "integer",
          "description": "Submissions awaiting review. Only present for a viewer acting as the group."
        },
        "lastActivityAt": {
          "type": "string",
          "format": "datetime",
          "description": "When the pool last changed."
        },
        "viewer": {
          "type": "ref",
          "ref": "#viewerState"
        },
        "joinPolicy": {
          "type": "string",
          "knownValues": ["open", "request", "invite"],
          "description": "How to get in, from the group's public profile."
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#rule"
          }
        }
      }
    },
    "viewerState": {
      "type": "object",
      "properties": {
        "acting": {
          "type": "boolean",
          "description": "The viewer is signed in as this group, so may accept and remove."
        },
        "submission": {
          "type": "ref",
          "ref": "#submissionState",
          "description": "The viewer's standing for the gallery named in the request, if one was."
        },
        "member": {
          "type": "boolean",
          "description": "The viewer has accepted membership of this group, as their own PDS lists it. A claim, not access: the host decides that."
        }
      }
    },
    "submissionState": {
      "type": "object",
      "required": ["uri", "status"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "The submission record."
        },
        "status": {
          "type": "string",
          "knownValues": ["pending", "accepted", "declined"]
        },
        "item": {
          "type": "string",
          "format": "at-uri",
          "description": "The group's item record, once accepted."
        }
      }
    },
    "groupRef": {
      "type": "object",
      "required": ["did", "handle", "item"],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "handle": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "item": {
          "type": "string",
          "format": "at-uri",
          "description": "The social.grain.group.item that pools this gallery."
        }
      }
    },
    "submissionView": {
      "type": "object",
      "required": ["uri", "cid", "group", "gallery", "createdAt"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "group": {
          "type": "string",
          "format": "did"
        },
        "gallery": {
          "type": "ref",
          "ref": "social.grain.gallery.defs#galleryView"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["uri", "title"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "poolFeedItem": {
      "type": "object",
      "required": ["space", "group", "did", "rkey", "title", "photoCount", "items"],
      "properties": {
        "space": { "type": "string" },
        "group": { "type": "string", "format": "did", "description": "Whose pool it is in." },
        "did": { "type": "string", "format": "did", "description": "Whose gallery it is." },
        "handle": { "type": "string" },
        "displayName": { "type": "string" },
        "avatar": {
          "type": "string",
          "description": "The author's Grain profile picture, a public record of their own."
        },
        "rkey": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "datetime" },
        "photoCount": { "type": "integer" },
        "items": {
          "type": "array",
          "items": { "type": "ref", "ref": "#galleryItem" }
        },
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "What a favourite or a comment names."
        },
        "favCount": { "type": "integer" },
        "viewerFav": { "type": "string" },
        "commentCount": { "type": "integer" }
      }
    },
    "poolGallery": {
      "type": "object",
      "required": ["space", "did", "rkey", "title", "photoCount"],
      "properties": {
        "space": { "type": "string" },
        "did": { "type": "string", "format": "did", "description": "Whose gallery it is." },
        "handle": { "type": "string" },
        "displayName": { "type": "string" },
        "avatar": {
          "type": "string",
          "description": "The author's Grain profile picture, a public record of their own."
        },
        "rkey": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "datetime" },
        "photoCount": { "type": "integer" },
        "cover": { "type": "ref", "ref": "#galleryItem" },
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "What a favourite or a comment names."
        },
        "favCount": { "type": "integer" },
        "viewerFav": { "type": "string" },
        "commentCount": { "type": "integer" }
      }
    },
    "poolComment": {
      "type": "object",
      "required": ["uri", "rkey", "text", "author"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "rkey": { "type": "string" },
        "text": { "type": "string" },
        "facets": {
          "type": "array",
          "items": { "type": "ref", "ref": "app.bsky.richtext.facet" }
        },
        "replyTo": { "type": "string", "format": "at-uri" },
        "createdAt": { "type": "string", "format": "datetime" },
        "author": { "type": "ref", "ref": "#poolAuthor" }
      }
    },
    "poolAuthor": {
      "type": "object",
      "required": ["did"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string" },
        "displayName": { "type": "string" },
        "avatar": { "type": "string" }
      }
    },
    "photoInput": {
      "type": "object",
      "required": ["photo", "aspectRatio"],
      "properties": {
        "photo": { "type": "blob", "accept": ["image/*"], "maxSize": 1000000 },
        "alt": { "type": "string" },
        "aspectRatio": { "type": "ref", "ref": "social.grain.defs#aspectRatio" }
      }
    },
    "galleryRecord": {
      "type": "object",
      "required": ["uri", "title"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "datetime" }
      }
    },
    "galleryItem": {
      "type": "object",
      "required": ["uri", "did", "cid", "position"],
      "properties": {
        "uri": { "type": "string", "description": "Space URI of the photo record." },
        "did": {
          "type": "string",
          "format": "did",
          "description": "Repo holding the photo, and its blob."
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "Blob CID. Fetch through the space, never the CDN."
        },
        "alt": { "type": "string" },
        "aspectRatio": { "type": "ref", "ref": "social.grain.defs#aspectRatio" },
        "position": { "type": "integer" }
      }
    }
  }
}
