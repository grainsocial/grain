{
  "lexicon": 1,
  "id": "social.grain.group.getGallery",
  "defs": {
    "main": {
      "type": "query",
      "description": "One gallery from a group's pool, read from the repo that holds it through a credential the group's host issues.",
      "parameters": {
        "type": "params",
        "required": ["group", "did", "rkey"],
        "properties": {
          "group": { "type": "string", "format": "did" },
          "did": { "type": "string", "format": "did", "description": "Whose gallery it is." },
          "rkey": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "did", "items"],
          "properties": {
            "space": { "type": "string" },
            "did": { "type": "string", "format": "did" },
            "handle": { "type": "string" },
            "displayName": { "type": "string" },
            "viewerIsAuthor": { "type": "boolean" },
            "gallery": { "type": "ref", "ref": "social.grain.group.defs#galleryRecord" },
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "social.grain.group.defs#galleryItem" }
            },
            "avatar": { "type": "string" },
            "favCount": { "type": "integer" },
            "viewerFav": {
              "type": "string",
              "description": "The rkey of the viewer's own favourite, when they have one."
            },
            "commentCount": { "type": "integer" },
            "comments": {
              "type": "array",
              "items": { "type": "ref", "ref": "social.grain.group.defs#poolComment" }
            }
          }
        }
      },
      "errors": [
        { "name": "NotAuthorized", "description": "The viewer is not a member of this pool." }
      ]
    }
  }
}
