{
  "lexicon": 1,
  "id": "social.grain.unspecced.joinGroup",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Ask a group's community host to admit the viewer: Grain mints service auth for the host from the viewer's PDS and calls fyi.opensocial.requestJoin. Admitted immediately when the group is open; queued for its moderators when it takes requests.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["group"],
          "properties": {
            "group": {
              "type": "string",
              "format": "did"
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "knownValues": ["admitted", "pending"]
            }
          }
        }
      }
    }
  }
}
