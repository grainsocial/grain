{
  "lexicon": 1,
  "id": "social.grain.unspecced.listGroups",
  "defs": {
    "main": {
      "type": "query",
      "description": "Groups worth browsing, most recently active first. With `gallery`, each group carries the viewer's standing for that gallery.",
      "parameters": {
        "type": "params",
        "properties": {
          "gallery": {
            "type": "string",
            "format": "at-uri"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["groups"],
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "social.grain.group.defs#groupView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
