{
  "lexicon": 1,
  "id": "community.opensocial.declaration",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "description": "Marks a DID as a community. Lives in the public repo. Points at the about space. Discovery only.",
      "record": {
        "type": "object",
        "required": ["about", "createdAt"],
        "properties": {
          "about": {
            "type": "string",
            "format": "space-ref",
            "description": "The community's about space."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
