{
  "lexicon": 1,
  "id": "fyi.opensocial.declaration",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "description": "Marks a DID as a group. Lives in the public repo. Points at the about space. Discovery only.",
      "record": {
        "type": "object",
        "required": ["meta", "createdAt"],
        "properties": {
          "meta": {
            "type": "string",
            "format": "space-ref",
            "description": "The group's about space."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
