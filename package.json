{
  "name": "grain",
  "private": true,
  "type": "module",
  "scripts": {
    "lex": "rm -rf .lexicons && mkdir .lexicons && cp -R lexicons/. .lexicons/ && rm -rf .lexicons/dev/hatk .lexicons/social/grain/unspecced .lexicons/social/grain/group.json .lexicons/social/grain/privateGallery.json .lexicons/fyi/opensocial/declaration.json && lex build --lexicons .lexicons --out web/src/lib/lexicons --clear --import-ext .ts",
    "start": "hatk start",
    "dev": "npm run lex && vp dev",
    "build": "npm run lex && vp build",
    "check": "npm run lex && vp check && svelte-check",
    "format": "vp format",
    "test": "vp test",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:browser": "npx playwright test"
  },
  "dependencies": {
    "@hatk/hatk": "^0.0.1-alpha.115",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.55.0",
    "@tanstack/svelte-query": "^6.1.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "h3-js": "^4.4.0",
    "lucide-svelte": "^0.576.0",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0",
    "protomaps-themes-base": "^4.5.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@atproto/lex": "0.4.4",
    "@playwright/test": "^1",
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@voidzero-dev/vite-plus-core": "^0.3.0",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite-plus": "^0.3.0"
  },
  "overrides": {
    "@vitest/browser": "5.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/browser-preview": "5.0.0",
    "@vitest/browser-webdriverio": "5.0.0-rc.1",
    "@vitest/expect": "5.0.0",
    "@vitest/mocker": "5.0.0",
    "@vitest/pretty-format": "5.0.0",
    "@vitest/snapshot": "5.0.0",
    "@vitest/spy": "5.0.0",
    "@vitest/utils": "5.0.0",
    "vitest": "5.0.0"
  },
  "packageManager": "npm@11.11.1"
}
