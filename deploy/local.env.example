# deploy.sh and logs.sh read deploy/local.env, if there is one, for what
# they are not given on the command line.
GRAIN_HOST=root@203.0.113.10
GRAIN_DOMAIN=example.com
# GRAIN_PROXY_NETWORK=grain-serve
# GRAIN_DATA=/mnt/data/grain-serve
# The accounts, by DID and comma-separated, that moderate.
# GRAIN_ADMIN_DIDS=did:plc:...
# grain's imgproxy, its key and salt in /etc/grain-serve/serve.env:
# GRAIN_CDN=https://cdn.example.com
# Push, its key files named in serve.env:
# GRAIN_APNS_KEY_ID=...
# GRAIN_APNS_TEAM_ID=...
# GRAIN_APNS_TOPIC=social.grain.grain
# GRAIN_FCM_PROJECT_ID=...
# Until when the web carries the old server's cookies:
# GRAIN_CARRY_COOKIES_UNTIL=2027-01-01T00:00:00Z
